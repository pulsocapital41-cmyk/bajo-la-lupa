---
interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
  type?: 'website' | 'article';
  pubDate?: Date;
  author?: string;
}

const {
  title = "Bajo la Lupa CDMX — Periodismo de Investigación y Vigilancia Ciudadana en la GAM",
  description = "Portal independiente de investigación, rendición de cuentas, fiscalización de recursos y periodismo ciudadano en la Alcaldía Gustavo A. Madero de la Ciudad de México.",
  image = "/logo.png",
  canonicalURL = Astro.url.href,
  type = "website",
  pubDate,
  author = "Unidad de Investigación Bajo la Lupa",
} = Astro.props;

const siteTitle = title.includes("Bajo la Lupa") ? title : `${title} — Bajo la Lupa CDMX`;

const sections = [
  { name: "GAM al Día", href: "/seccion/gam-al-dia/" },
  { name: "Obras & Presupuesto", href: "/seccion/obras-y-presupuesto/" },
  { name: "Seguridad", href: "/seccion/seguridad/" },
  { name: "Denuncia Ciudadana", href: "/seccion/denuncia-ciudadana/" },
  { name: "Opinión", href: "/seccion/opinion/" },
];

const siteUrl = 'https://bajolalupa.com.mx';
const currentCanonical = canonicalURL || Astro.url.href;

const jsonLd = type === 'article'
  ? {
      '@context': 'https://schema.org',
      '@type': 'NewsArticle',
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': currentCanonical.toString(),
      },
      headline: siteTitle,
      description: description,
      image: [image.startsWith('http') ? image : new URL(image, siteUrl).toString()],
      datePublished: pubDate ? new Date(pubDate).toISOString() : new Date().toISOString(),
      dateModified: pubDate ? new Date(pubDate).toISOString() : new Date().toISOString(),
      author: [
        {
          '@type': 'Person',
          name: author,
        },
      ],
      publisher: {
        '@type': 'NewsMediaOrganization',
        name: 'Bajo la Lupa CDMX',
        url: siteUrl,
        logo: {
          '@type': 'ImageObject',
          url: `${siteUrl}/logo.png`,
        },
      },
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'NewsMediaOrganization',
      name: 'Bajo la Lupa CDMX',
      url: siteUrl,
      logo: `${siteUrl}/logo.png`,
      description: description,
    };
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="canonical" href={canonicalURL} />

  <!-- Primary Meta Tags -->
  <title>{siteTitle}</title>
  <meta name="title" content={siteTitle} />
  <meta name="description" content={description} />
  <meta name="author" content={author} />

  <!-- Open Graph / WhatsApp / Facebook -->
  <meta property="og:type" content={type} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={siteTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL(image, Astro.url)} />
  <meta property="og:site_name" content="Bajo la Lupa CDMX" />
  <meta property="og:locale" content="es_MX" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:url" content={canonicalURL} />
  <meta name="twitter:title" content={siteTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={new URL(image, Astro.url)} />

  <!-- Google Fonts: Montserrat (Titulares serios y sólidos acordes al logo) + Inter (Lectura limpia) + JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700&family=Montserrat:wght@600;700;800;900&display=swap" rel="stylesheet" />

  <style is:global>
    :root {
      --ink-primary: #111418;
      --ink-secondary: #313740;
      --ink-muted: #647080;
      --bg-page: #f8fafc;
      --bg-surface: #ffffff;
      --gold-lupa: #927740;
      --gold-dark: #745d2e;
      --gold-subtle: #f8f5ee;
      --gold-border: #dfd4be;
      --alert-red: #d32f2f;
      --border-light: #e5e9ee;
      --border-dark: #111418;
      --font-headline: 'Montserrat', -apple-system, BlinkMacSystemFont, sans-serif;
      --font-body: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      --font-mono: 'JetBrains Mono', monospace;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: var(--bg-page);
      color: var(--ink-primary);
      font-family: var(--font-body);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
    }

    a {
      color: inherit;
      text-decoration: none;
      transition: color 0.15s ease;
    }

    img {
      max-width: 100%;
      height: auto;
      display: block;
    }

    .container {
      width: 100%;
      max-width: 1220px;
      margin: 0 auto;
      padding: 0 20px;
    }

    /* HEADER MINIMALISTA & MODERNO */
    .site-header {
      background: var(--bg-surface);
      border-bottom: 2px solid var(--border-dark);
      position: sticky;
      top: 0;
      z-index: 100;
      box-shadow: 0 1px 4px rgba(0,0,0,0.04);
    }
    .site-header__inner {
      display: flex;
      justify-content: space-between;
      align-items: center;
      height: 70px;
      gap: 20px;
    }
    .brand-logo-link {
      display: flex;
      align-items: center;
      flex-shrink: 0;
    }
    .brand-logo-img {
      height: 42px;
      width: auto;
      object-fit: contain;
    }

    /* NAV LINKS */
    .nav-links {
      display: flex;
      list-style: none;
      gap: 4px;
      overflow-x: auto;
      white-space: nowrap;
    }
    .nav-link {
      display: block;
      padding: 8px 14px;
      font-family: var(--font-headline);
      font-size: 13px;
      font-weight: 700;
      color: var(--ink-secondary);
      border-radius: 4px;
      letter-spacing: -0.01em;
      transition: all 0.15s ease;
    }
    .nav-link:hover {
      color: var(--ink-primary);
      background: var(--gold-subtle);
    }

    /* HEADER ACTIONS */
    .header-actions {
      display: flex;
      align-items: center;
      gap: 12px;
      flex-shrink: 0;
    }
    .btn-denuncia-header {
      background: var(--border-dark);
      color: #fff;
      font-family: var(--font-headline);
      font-size: 11.5px;
      font-weight: 700;
      padding: 8px 15px;
      border-radius: 4px;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      letter-spacing: 0.02em;
      transition: background 0.15s;
    }
    .btn-denuncia-header:hover {
      background: var(--gold-lupa);
      color: #fff;
    }

    /* FOOTER */
    .footer {
      background: #111418;
      color: #d1d5db;
      padding: 48px 0 25px;
      margin-top: 60px;
      border-top: 3px solid var(--gold-lupa);
    }
    .footer__grid {
      display: grid;
      grid-template-columns: 2fr 1.2fr 1.5fr;
      gap: 40px;
      margin-bottom: 35px;
    }
    .footer__brand img {
      height: 38px;
      width: auto;
      margin-bottom: 14px;
      filter: brightness(0) invert(1);
    }
    .footer__brand p {
      font-size: 13px;
      color: #94a3b8;
      line-height: 1.6;
      max-width: 420px;
    }
    .footer__col-title {
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--gold-lupa);
      margin-bottom: 14px;
      font-family: var(--font-mono);
    }
    .footer__links {
      list-style: none;
    }
    .footer__links li {
      margin-bottom: 8px;
    }
    .footer__links a {
      font-size: 13px;
      color: #cbd5e1;
    }
    .footer__links a:hover {
      color: #fff;
      text-decoration: underline;
    }
    .footer__box {
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(255,255,255,0.1);
      padding: 16px;
      border-radius: 4px;
    }
    .footer__box-title {
      font-size: 13px;
      font-weight: 700;
      color: #fff;
      margin-bottom: 5px;
      font-family: var(--font-headline);
    }
    .footer__box-desc {
      font-size: 11.5px;
      color: #94a3b8;
      margin-bottom: 12px;
      line-height: 1.5;
    }
    .footer__box-btn {
      display: inline-block;
      background: var(--gold-lupa);
      color: #fff;
      font-size: 11.5px;
      font-weight: 700;
      padding: 7px 12px;
      border-radius: 3px;
      font-family: var(--font-headline);
    }
    .footer__bottom {
      border-top: 1px solid rgba(255,255,255,0.08);
      padding-top: 20px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 11.5px;
      color: #64748b;
    }

    @media (max-width: 900px) {
      .footer__grid {
        grid-template-columns: 1fr;
        gap: 25px;
      }
      .nav-links {
        display: none;
      }
    }
  </style>

  <!-- Search Engine & Google News Directives -->
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  <meta name="googlebot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  
  <!-- Structured Data (JSON-LD) -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

</head>
<body>
  <!-- Header Minimalista y Limpio -->
  <header class="site-header">
    <div class="container site-header__inner">
      <a href="/" class="brand-logo-link" aria-label="Bajo la Lupa CDMX — Inicio">
        <img src="/logo.png" alt="Bajo la Lupa CDMX" class="brand-logo-img" width="147" height="50" fetchpriority="high" />
      </a>

      <nav aria-label="Navegación principal">
        <ul class="nav-links">
          <li><a href="/" class="nav-link">Inicio</a></li>
          {sections.map(sec => (
            <li><a href={sec.href} class="nav-link">{sec.name}</a></li>
          ))}
        </ul>
      </nav>

      <div class="header-actions">
        <a href="/#denuncia" class="btn-denuncia-header">
          <span>🔎 Buzón de Denuncia</span>
        </a>
      </div>
    </div>
  </header>

  <!-- Main Content -->
  <main>
    <slot />
  </main>

  <!-- Footer -->
  <footer class="footer">
    <div class="container">
      <div class="footer__grid">
        <div class="footer__brand">
          <img src="/logo.png" alt="Bajo la Lupa CDMX" width="130" height="44" loading="lazy" />
          <p>
            Periodismo de investigación, contraloría ciudadana y rendición de cuentas en la Alcaldía Gustavo A. Madero de la Ciudad de México.
          </p>
        </div>
        <div>
          <div class="footer__col-title">Secciones de Cobertura</div>
          <ul class="footer__links">
            <li><a href="/">Portada</a></li>
            {sections.map(sec => (
              <li><a href={sec.href}>{sec.name}</a></li>
            ))}
            <li><a href="/rss.xml">Canal RSS</a></li>
          </ul>
        </div>
        <div>
          <div class="footer__col-title">Buzón Confidencial</div>
          <div class="footer__box">
            <div class="footer__box-title">¿Tienes un reporte vecinal?</div>
            <div class="footer__box-desc">
              Garantizamos confidencialidad estricta para vecinos y trabajadores de la GAM.
            </div>
            <a href="mailto:denuncia@bajolalupa.com.mx" class="footer__box-btn">denuncia@bajolalupa.com.mx</a>
          </div>
        </div>
      </div>

      <div class="footer__bottom">
        <p>© 2026 <strong>Bajo la Lupa CDMX</strong>. Todos los derechos reservados.</p>
        <p>Gustavo A. Madero · Ciudad de México</p>
      </div>
    </div>
  </footer>
</body>
</html>
