---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allArticles = await getCollection('noticias');
const sortedArticles = allArticles.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

// Lead article (featured or latest)
const leadArticle = sortedArticles.find(a => a.data.featured) || sortedArticles[0];
const otherArticles = sortedArticles.filter(a => a.id !== leadArticle.id);

const formatDate = (d: Date) => {
  return new Intl.DateTimeFormat('es-MX', {
    day: 'numeric',
    month: 'long',
    year: 'numeric'
  }).format(d);
};
---

<BaseLayout title="Bajo la Lupa CDMX — Periodismo de Investigación en Gustavo A. Madero">
  <div class="container main-content">

    <!-- BARRA DE ALERTA INVESTIGATIVA -->
    <div class="investigative-ticker">
      <span class="ticker-badge">EXPEDIENTE ABIERTO</span>
      <span class="ticker-text">Auditoría social en marcha: Seguimiento al ejercicio de obras públicas y abasto de agua en las 233 colonias de la GAM.</span>
      <a href="#denuncia" class="ticker-cta">Aportar evidencia →</a>
    </div>

    <!-- EXPEDIENTE CENTRAL (HERO LEAD) -->
    {leadArticle && (
      <section class="lead-dossier">
        <div class="lead-dossier__media">
          <a href={`/noticias/${leadArticle.id}/`}>
            <img src={leadArticle.data.image} alt={leadArticle.data.title} class="lead-dossier__img" />
          </a>
          <div class="lead-dossier__status-pill">
            <span class="status-dot"></span>
            <span>{leadArticle.data.status || 'Expediente Especial'}</span>
          </div>
        </div>
        <div class="lead-dossier__body">
          <div class="dossier-meta-top">
            <span class="dossier-code">{leadArticle.data.expedienteNo || 'EXP-GAM-2026'}</span>
            <span class="dossier-category">{leadArticle.data.category}</span>
          </div>
          <h1 class="lead-dossier__title">
            <a href={`/noticias/${leadArticle.id}/`}>{leadArticle.data.title}</a>
          </h1>
          <p class="lead-dossier__excerpt">{leadArticle.data.excerpt || leadArticle.data.subtitle}</p>
          <div class="lead-dossier__footer">
            <div class="author-info">
              <span class="author-name">{leadArticle.data.author}</span>
              <span class="author-date">{formatDate(leadArticle.data.pubDate)}</span>
            </div>
            <a href={`/noticias/${leadArticle.id}/`} class="btn-read-dossier">
              <span>Leer Expediente Completo</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
            </a>
          </div>
        </div>
      </section>
    )}

    <!-- GRILLA DE INVESTIGACIONES & FISCALIZACIÓN -->
    <section class="investigations-grid-section">
      <div class="section-heading">
        <h2 class="section-title">Investigaciones & Auditorías Recientes</h2>
        <span class="section-subtitle">Contraloría vecinal en las 8 zonas territoriales de la alcaldía</span>
      </div>

      <div class="investigations-grid">
        {otherArticles.slice(0, 3).map(art => (
          <article class="investigation-card">
            <div class="card-media">
              <a href={`/noticias/${art.id}/`}>
                <img src={art.data.image} alt={art.data.title} loading="lazy" />
              </a>
              <span class="card-category-badge">{art.data.category}</span>
            </div>
            <div class="card-content">
              {art.data.expedienteNo && (
                <span class="card-dossier-code">{art.data.expedienteNo}</span>
              )}
              <h3 class="card-title">
                <a href={`/noticias/${art.id}/`}>{art.data.title}</a>
              </h3>
              <p class="card-excerpt">{art.data.excerpt}</p>
              <div class="card-meta">
                <span>{art.data.author}</span>
                <span>·</span>
                <time>{formatDate(art.data.pubDate)}</time>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- SECCIÓN DOS COLUMNAS: RADAR VECINAL + BUZÓN DE DENUNCIA -->
    <section class="radar-whistleblower-section">
      <div class="radar-col">
        <div class="section-heading">
          <h2 class="section-title">Crónica y Seguimiento Barrial</h2>
        </div>
        <div class="radar-articles-list">
          {otherArticles.slice(3).map(art => (
            <article class="radar-article-row">
              <div class="radar-article-thumb">
                <a href={`/noticias/${art.id}/`}>
                  <img src={art.data.image} alt={art.data.title} loading="lazy" />
                </a>
              </div>
              <div class="radar-article-info">
                <span class="radar-category">{art.data.category}</span>
                <h4 class="radar-title">
                  <a href={`/noticias/${art.id}/`}>{art.data.title}</a>
                </h4>
                <time class="radar-date">{formatDate(art.data.pubDate)}</time>
              </div>
            </article>
          ))}
        </div>
      </div>

      <!-- BUZÓN DE DENUNCIA CIUDADANA -->
      <div class="whistleblower-col" id="denuncia">
        <div class="whistleblower-card">
          <div class="whistleblower-badge">Canal Seguro 100% Confidencial</div>
          <h3 class="whistleblower-title">Buzón de Denuncia Ciudadana GAM</h3>
          <p class="whistleblower-desc">
            ¿Detectaste una obra fantasma, anomalías en contratos, cobro indebido de servicios o irregularidades en tu colonia?
          </p>
          <ul class="whistleblower-checks">
            <li>✓ Resguardo estricto del anonimato de la fuente</li>
            <li>✓ Verificación de documentos y pruebas en campo</li>
            <li>✓ Cobertura independiente sin compromisos políticos</li>
          </ul>
          <div class="whistleblower-contact">
            <span class="contact-label">Envía expedientes, fotos o reportes a:</span>
            <a href="mailto:denuncia@bajolalupa.com.mx" class="contact-email">denuncia@bajolalupa.com.mx</a>
          </div>
          <a href="mailto:denuncia@bajolalupa.com.mx?subject=Denuncia%20Ciudadana%20GAM" class="btn-send-whistleblower">
            <span>Enviar Denuncia a la Redacción</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
          </a>
        </div>
      </div>
    </section>

  </div>
</BaseLayout>

<style>
  .main-content {
    padding-top: 24px;
  }

  /* TICKER */
  .investigative-ticker {
    background: #fff;
    border: 1px solid var(--border-light);
    border-left: 4px solid var(--gold-lupa);
    padding: 10px 16px;
    border-radius: 4px;
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 13px;
    margin-bottom: 24px;
    flex-wrap: wrap;
  }
  .ticker-badge {
    background: var(--gold-subtle);
    color: var(--gold-dark);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 3px;
    letter-spacing: 0.05em;
  }
  .ticker-text {
    color: var(--ink-secondary);
    font-weight: 500;
    flex: 1;
  }
  .ticker-cta {
    color: var(--gold-lupa);
    font-weight: 700;
    white-space: nowrap;
  }
  .ticker-cta:hover {
    text-decoration: underline;
  }

  /* LEAD DOSSIER */
  .lead-dossier {
    background: var(--bg-surface);
    border: 1px solid var(--border-light);
    border-radius: 6px;
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    overflow: hidden;
    margin-bottom: 45px;
    box-shadow: 0 4px 16px rgba(0,0,0,0.04);
  }
  .lead-dossier__media {
    position: relative;
    background: #000;
  }
  .lead-dossier__img {
    width: 100%;
    height: 100%;
    min-height: 380px;
    object-fit: cover;
    transition: transform 0.3s ease;
  }
  .lead-dossier__media:hover .lead-dossier__img {
    transform: scale(1.02);
  }
  .lead-dossier__status-pill {
    position: absolute;
    top: 14px;
    left: 14px;
    background: rgba(24, 27, 30, 0.9);
    backdrop-filter: blur(4px);
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 4px;
    display: flex;
    align-items: center;
    gap: 6px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #4ade80;
  }
  .lead-dossier__body {
    padding: 35px 35px 30px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .dossier-meta-top {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
  }
  .dossier-code {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    color: var(--gold-dark);
    background: var(--gold-subtle);
    border: 1px solid var(--gold-border);
    padding: 2px 7px;
    border-radius: 3px;
  }
  .dossier-category {
    font-size: 12px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-muted);
  }
  .lead-dossier__title {
    font-family: var(--font-serif);
    font-size: 27px;
    line-height: 1.28;
    color: var(--ink-primary);
    margin-bottom: 14px;
    font-weight: 700;
  }
  .lead-dossier__title a:hover {
    color: var(--gold-lupa);
  }
  .lead-dossier__excerpt {
    font-size: 14.5px;
    color: var(--ink-secondary);
    line-height: 1.6;
    margin-bottom: 24px;
  }
  .lead-dossier__footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid var(--border-light);
    padding-top: 20px;
  }
  .author-info {
    display: flex;
    flex-direction: column;
  }
  .author-name {
    font-size: 13px;
    font-weight: 700;
    color: var(--ink-primary);
  }
  .author-date {
    font-size: 11.5px;
    color: var(--ink-muted);
  }
  .btn-read-dossier {
    background: var(--ink-primary);
    color: #fff;
    font-size: 12.5px;
    font-weight: 700;
    padding: 9px 16px;
    border-radius: 4px;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    transition: background 0.15s;
  }
  .btn-read-dossier:hover {
    background: var(--gold-lupa);
  }

  /* HEADINGS */
  .section-heading {
    margin-bottom: 20px;
    border-bottom: 2px solid var(--border-light);
    padding-bottom: 8px;
    position: relative;
  }
  .section-heading::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 60px;
    height: 2px;
    background: var(--gold-lupa);
  }
  .section-title {
    font-family: var(--font-serif);
    font-size: 20px;
    color: var(--ink-primary);
    font-weight: 700;
  }
  .section-subtitle {
    font-size: 12px;
    color: var(--ink-muted);
  }

  /* INVESTIGATIONS GRID */
  .investigations-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-bottom: 50px;
  }
  .investigation-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-light);
    border-radius: 5px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .investigation-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(0,0,0,0.06);
  }
  .card-media {
    position: relative;
    height: 180px;
    background: #000;
  }
  .card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .card-category-badge {
    position: absolute;
    bottom: 10px;
    left: 10px;
    background: var(--gold-lupa);
    color: #fff;
    font-size: 10.5px;
    font-weight: 800;
    padding: 3px 8px;
    border-radius: 3px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .card-content {
    padding: 20px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .card-dossier-code {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    color: var(--gold-dark);
    margin-bottom: 6px;
  }
  .card-title {
    font-family: var(--font-serif);
    font-size: 16.5px;
    line-height: 1.35;
    margin-bottom: 10px;
    font-weight: 700;
  }
  .card-title a:hover {
    color: var(--gold-lupa);
  }
  .card-excerpt {
    font-size: 13px;
    color: var(--ink-secondary);
    line-height: 1.5;
    margin-bottom: 16px;
    flex: 1;
  }
  .card-meta {
    font-size: 11.5px;
    color: var(--ink-muted);
    display: flex;
    gap: 6px;
    border-top: 1px solid var(--border-light);
    padding-top: 12px;
  }

  /* RADAR & WHISTLEBLOWER SECTION */
  .radar-whistleblower-section {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 32px;
  }
  .radar-articles-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .radar-article-row {
    background: var(--bg-surface);
    border: 1px solid var(--border-light);
    border-radius: 5px;
    padding: 14px;
    display: grid;
    grid-template-columns: 100px 1fr;
    gap: 15px;
    align-items: center;
  }
  .radar-article-thumb {
    height: 75px;
    border-radius: 4px;
    overflow: hidden;
  }
  .radar-article-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .radar-category {
    font-size: 10.5px;
    font-weight: 800;
    color: var(--gold-lupa);
    text-transform: uppercase;
  }
  .radar-title {
    font-family: var(--font-serif);
    font-size: 14.5px;
    line-height: 1.3;
    margin: 4px 0;
    font-weight: 700;
  }
  .radar-title a:hover {
    color: var(--gold-lupa);
  }
  .radar-date {
    font-size: 11px;
    color: var(--ink-muted);
  }

  /* WHISTLEBLOWER CARD */
  .whistleblower-card {
    background: linear-gradient(135deg, #1f2327 0%, #16181b 100%);
    color: #fff;
    border-radius: 6px;
    padding: 30px;
    border-top: 4px solid var(--gold-lupa);
    box-shadow: 0 6px 20px rgba(0,0,0,0.08);
  }
  .whistleblower-badge {
    display: inline-block;
    background: rgba(148, 121, 66, 0.25);
    border: 1px solid var(--gold-lupa);
    color: #e5cf9d;
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 3px;
    margin-bottom: 12px;
  }
  .whistleblower-title {
    font-family: var(--font-serif);
    font-size: 20px;
    margin-bottom: 10px;
  }
  .whistleblower-desc {
    font-size: 13px;
    color: #cbd5e1;
    line-height: 1.5;
    margin-bottom: 16px;
  }
  .whistleblower-checks {
    list-style: none;
    font-size: 12px;
    color: #94a3b8;
    margin-bottom: 20px;
  }
  .whistleblower-checks li {
    margin-bottom: 6px;
  }
  .whistleblower-contact {
    background: rgba(255,255,255,0.05);
    border: 1px dashed rgba(255,255,255,0.2);
    padding: 12px;
    border-radius: 4px;
    margin-bottom: 16px;
  }
  .contact-label {
    display: block;
    font-size: 11px;
    color: #94a3b8;
  }
  .contact-email {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 700;
    color: #fff;
  }
  .btn-send-whistleblower {
    background: var(--gold-lupa);
    color: #fff;
    font-size: 13px;
    font-weight: 700;
    padding: 11px;
    border-radius: 4px;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    transition: background 0.15s;
  }
  .btn-send-whistleblower:hover {
    background: var(--gold-dark);
  }

  @media (max-width: 900px) {
    .lead-dossier {
      grid-template-columns: 1fr;
    }
    .investigations-grid {
      grid-template-columns: 1fr;
    }
    .radar-whistleblower-section {
      grid-template-columns: 1fr;
    }
  }
</style>
