---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allArticles = await getCollection('noticias');
const sortedArticles = allArticles.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

// Lead article (featured or latest)
const leadArticle = sortedArticles.find(a => a.data.featured) || sortedArticles[0];
const otherArticles = sortedArticles.filter(a => a.id !== leadArticle.id);

const formatDate = (d: Date) => {
  return new Intl.DateTimeFormat('es-MX', {
    day: 'numeric',
    month: 'short',
    year: 'numeric'
  }).format(d);
};
---

<BaseLayout title="Bajo la Lupa CDMX — Periodismo de Investigación en Gustavo A. Madero">
  <div class="container main-content">

    <!-- BARRA COMPACTA DE EXPEDIENTE -->
    <div class="dossier-ticker">
      <span class="ticker-badge">EXPEDIENTE ABIERTO</span>
      <span class="ticker-text">Contraloría social en marcha: Obras públicas y abasto hídrico en las 233 colonias de la GAM.</span>
      <a href="#denuncia" class="ticker-cta">Aportar reporte →</a>
    </div>

    <!-- EXPEDIENTE CENTRAL (HERO LEAD) -->
    {leadArticle && (
      <section class="lead-dossier">
        <div class="lead-dossier__media">
          <a href={`/noticias/${leadArticle.id}/`}>
            <img src={leadArticle.data.image} alt={leadArticle.data.title} class="lead-dossier__img" onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1570125909232-eb263c188f7e?auto=format&fit=crop&w=1280&q=80'" />
          </a>
          <div class="lead-dossier__status-pill">
            <span class="status-dot"></span>
            <span>{leadArticle.data.status || 'Expediente Especial'}</span>
          </div>
        </div>
        <div class="lead-dossier__body">
          <div class="dossier-meta-top">
            <span class="dossier-code">{leadArticle.data.expedienteNo || 'EXP-GAM-2026'}</span>
            <span class="dossier-category">{leadArticle.data.category}</span>
          </div>
          <h1 class="lead-dossier__title">
            <a href={`/noticias/${leadArticle.id}/`}>{leadArticle.data.title}</a>
          </h1>
          <p class="lead-dossier__excerpt">{leadArticle.data.excerpt || leadArticle.data.subtitle}</p>
          <div class="lead-dossier__footer">
            <div class="author-info">
              <span class="author-name">{leadArticle.data.author}</span>
              <span class="author-date">{formatDate(leadArticle.data.pubDate)}</span>
            </div>
            <a href={`/noticias/${leadArticle.id}/`} class="btn-read-dossier">
              <span>Ver Expediente</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
            </a>
          </div>
        </div>
      </section>
    )}

    <!-- GRILLA DE INVESTIGACIONES & FISCALIZACIÓN -->
    <section class="investigations-grid-section">
      <div class="section-heading">
        <h2 class="section-title">Investigaciones en Curso</h2>
        <span class="section-badge-pill">GAM CDMX</span>
      </div>

      <div class="investigations-grid">
        {otherArticles.slice(0, 3).map(art => (
          <article class="investigation-card">
            <div class="card-media">
              <a href={`/noticias/${art.id}/`}>
                <img src={art.data.image} alt={art.data.title} loading="lazy" onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1570125909232-eb263c188f7e?auto=format&fit=crop&w=1280&q=80'" />
              </a>
              <span class="card-category-badge">{art.data.category}</span>
            </div>
            <div class="card-content">
              {art.data.expedienteNo && (
                <span class="card-dossier-code">{art.data.expedienteNo}</span>
              )}
              <h3 class="card-title">
                <a href={`/noticias/${art.id}/`}>{art.data.title}</a>
              </h3>
              <p class="card-excerpt">{art.data.excerpt}</p>
              <div class="card-meta">
                <span>{art.data.author}</span>
                <span>·</span>
                <time>{formatDate(art.data.pubDate)}</time>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- SECCIÓN DOS COLUMNAS: SEGUIMIENTO BARRIAL + BUZÓN -->
    <section class="radar-whistleblower-section">
      <div class="radar-col">
        <div class="section-heading">
          <h2 class="section-title">Seguimiento Barrial</h2>
        </div>
        <div class="radar-articles-list">
          {otherArticles.slice(3).map(art => (
            <article class="radar-article-row">
              <div class="radar-article-thumb">
                <a href={`/noticias/${art.id}/`}>
                  <img src={art.data.image} alt={art.data.title} loading="lazy" onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1570125909232-eb263c188f7e?auto=format&fit=crop&w=1280&q=80'" />
                </a>
              </div>
              <div class="radar-article-info">
                <span class="radar-category">{art.data.category}</span>
                <h4 class="radar-title">
                  <a href={`/noticias/${art.id}/`}>{art.data.title}</a>
                </h4>
                <time class="radar-date">{formatDate(art.data.pubDate)}</time>
              </div>
            </article>
          ))}
        </div>
      </div>

      <!-- BUZÓN DE DENUNCIA CIUDADANA -->
      <div class="whistleblower-col" id="denuncia">
        <div class="whistleblower-card">
          <div class="whistleblower-badge">Canal Confidencial</div>
          <h3 class="whistleblower-title">Buzón de Denuncia Ciudadana GAM</h3>
          <p class="whistleblower-desc">
            ¿Detectaste obras inconclusas, cobros ilegales de agua o irregularidades en tu colonia? Recibimos tu reporte de forma segura.
          </p>
          <ul class="whistleblower-checks">
            <li>✓ Anonimato absoluto y protección a la fuente</li>
            <li>✓ Verificación documental e inspección de campo</li>
          </ul>
          <div class="whistleblower-contact">
            <span class="contact-label">Envía testimonios o documentos a:</span>
            <a href="mailto:denuncia@bajolalupa.com.mx" class="contact-email">denuncia@bajolalupa.com.mx</a>
          </div>
          <a href="mailto:denuncia@bajolalupa.com.mx?subject=Denuncia%20Ciudadana%20GAM" class="btn-send-whistleblower">
            <span>Escribir al Buzón de Denuncia</span>
          </a>
        </div>
      </div>
    </section>

  </div>
</BaseLayout>

<style>
  .main-content {
    padding-top: 24px;
  }

  /* TICKER */
  .dossier-ticker {
    background: #fff;
    border: 1px solid var(--border-light);
    border-left: 3px solid var(--gold-lupa);
    padding: 9px 14px;
    border-radius: 4px;
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 13px;
    margin-bottom: 22px;
    flex-wrap: wrap;
  }
  .ticker-badge {
    background: var(--gold-subtle);
    color: var(--gold-dark);
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 700;
    padding: 2px 7px;
    border-radius: 3px;
    letter-spacing: 0.05em;
  }
  .ticker-text {
    color: var(--ink-secondary);
    font-weight: 500;
    flex: 1;
  }
  .ticker-cta {
    color: var(--gold-lupa);
    font-weight: 700;
    white-space: nowrap;
    font-size: 12.5px;
  }
  .ticker-cta:hover {
    text-decoration: underline;
  }

  /* LEAD DOSSIER */
  .lead-dossier {
    background: var(--bg-surface);
    border: 1px solid var(--border-light);
    border-radius: 6px;
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    overflow: hidden;
    margin-bottom: 45px;
    box-shadow: 0 4px 16px rgba(0,0,0,0.03);
  }
  .lead-dossier__media {
    position: relative;
    background: #000;
  }
  .lead-dossier__img {
    width: 100%;
    height: 100%;
    min-height: 380px;
    object-fit: cover;
    transition: transform 0.3s ease;
  }
  .lead-dossier__media:hover .lead-dossier__img {
    transform: scale(1.02);
  }
  .lead-dossier__status-pill {
    position: absolute;
    top: 14px;
    left: 14px;
    background: rgba(18, 20, 23, 0.92);
    backdrop-filter: blur(4px);
    color: #fff;
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 700;
    padding: 4px 9px;
    border-radius: 3px;
    display: flex;
    align-items: center;
    gap: 6px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #22c55e;
  }
  .lead-dossier__body {
    padding: 32px 32px 28px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .dossier-meta-top {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
  }
  .dossier-code {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    color: var(--gold-dark);
    background: var(--gold-subtle);
    border: 1px solid var(--gold-border);
    padding: 2px 7px;
    border-radius: 3px;
  }
  .dossier-category {
    font-size: 11.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--ink-muted);
  }
  .lead-dossier__title {
    font-family: var(--font-headline);
    font-size: 26px;
    line-height: 1.2;
    color: var(--ink-primary);
    margin-bottom: 14px;
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .lead-dossier__title a:hover {
    color: var(--gold-lupa);
  }
  .lead-dossier__excerpt {
    font-size: 14.5px;
    color: var(--ink-secondary);
    line-height: 1.55;
    margin-bottom: 22px;
  }
  .lead-dossier__footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid var(--border-light);
    padding-top: 18px;
  }
  .author-info {
    display: flex;
    flex-direction: column;
  }
  .author-name {
    font-size: 12.5px;
    font-weight: 700;
    color: var(--ink-primary);
  }
  .author-date {
    font-size: 11.5px;
    color: var(--ink-muted);
    font-family: var(--font-mono);
  }
  .btn-read-dossier {
    background: var(--ink-primary);
    color: #fff;
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 700;
    padding: 9px 15px;
    border-radius: 4px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: background 0.15s;
  }
  .btn-read-dossier:hover {
    background: var(--gold-lupa);
  }

  /* HEADINGS */
  .section-heading {
    margin-bottom: 20px;
    border-bottom: 2px solid var(--border-light);
    padding-bottom: 8px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: relative;
  }
  .section-heading::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 50px;
    height: 2px;
    background: var(--gold-lupa);
  }
  .section-title {
    font-family: var(--font-headline);
    font-size: 20px;
    color: var(--ink-primary);
    font-weight: 800;
    letter-spacing: -0.01em;
  }
  .section-badge-pill {
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--gold-dark);
    background: var(--gold-subtle);
    padding: 2px 7px;
    border-radius: 3px;
    font-weight: 700;
  }

  /* INVESTIGATIONS GRID */
  .investigations-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
    margin-bottom: 45px;
  }
  .investigation-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-light);
    border-radius: 5px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .investigation-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(0,0,0,0.06);
  }
  .card-media {
    position: relative;
    height: 180px;
    background: #000;
  }
  .card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .card-category-badge {
    position: absolute;
    bottom: 10px;
    left: 10px;
    background: var(--gold-lupa);
    color: #fff;
    font-size: 10px;
    font-weight: 800;
    padding: 3px 7px;
    border-radius: 3px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .card-content {
    padding: 18px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .card-dossier-code {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    color: var(--gold-dark);
    margin-bottom: 6px;
  }
  .card-title {
    font-family: var(--font-headline);
    font-size: 16px;
    line-height: 1.25;
    margin-bottom: 8px;
    font-weight: 800;
    letter-spacing: -0.01em;
  }
  .card-title a:hover {
    color: var(--gold-lupa);
  }
  .card-excerpt {
    font-size: 13px;
    color: var(--ink-secondary);
    line-height: 1.5;
    margin-bottom: 14px;
    flex: 1;
  }
  .card-meta {
    font-size: 11px;
    color: var(--ink-muted);
    font-family: var(--font-mono);
    display: flex;
    gap: 6px;
    border-top: 1px solid var(--border-light);
    padding-top: 10px;
  }

  /* RADAR & WHISTLEBLOWER SECTION */
  .radar-whistleblower-section {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 30px;
  }
  .radar-articles-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .radar-article-row {
    background: var(--bg-surface);
    border: 1px solid var(--border-light);
    border-radius: 5px;
    padding: 12px;
    display: grid;
    grid-template-columns: 95px 1fr;
    gap: 14px;
    align-items: center;
  }
  .radar-article-thumb {
    height: 70px;
    border-radius: 4px;
    overflow: hidden;
  }
  .radar-article-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .radar-category {
    font-size: 10px;
    font-weight: 800;
    color: var(--gold-lupa);
    text-transform: uppercase;
  }
  .radar-title {
    font-family: var(--font-headline);
    font-size: 14px;
    line-height: 1.25;
    margin: 3px 0;
    font-weight: 700;
  }
  .radar-title a:hover {
    color: var(--gold-lupa);
  }
  .radar-date {
    font-size: 10.5px;
    color: var(--ink-muted);
    font-family: var(--font-mono);
  }

  /* WHISTLEBLOWER CARD */
  .whistleblower-card {
    background: #14171a;
    color: #fff;
    border-radius: 6px;
    padding: 26px;
    border-left: 4px solid var(--gold-lupa);
    box-shadow: 0 4px 16px rgba(0,0,0,0.06);
  }
  .whistleblower-badge {
    display: inline-block;
    background: rgba(146, 119, 64, 0.25);
    border: 1px solid var(--gold-lupa);
    color: #e2d1a8;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    padding: 2px 7px;
    border-radius: 3px;
    margin-bottom: 10px;
  }
  .whistleblower-title {
    font-family: var(--font-headline);
    font-size: 19px;
    margin-bottom: 8px;
    font-weight: 800;
  }
  .whistleblower-desc {
    font-size: 12.5px;
    color: #cbd5e1;
    line-height: 1.5;
    margin-bottom: 14px;
  }
  .whistleblower-checks {
    list-style: none;
    font-size: 11.5px;
    color: #94a3b8;
    margin-bottom: 18px;
  }
  .whistleblower-checks li {
    margin-bottom: 5px;
  }
  .whistleblower-contact {
    background: rgba(255,255,255,0.04);
    border: 1px dashed rgba(255,255,255,0.18);
    padding: 10px;
    border-radius: 4px;
    margin-bottom: 14px;
  }
  .contact-label {
    display: block;
    font-size: 10.5px;
    color: #94a3b8;
  }
  .contact-email {
    font-family: var(--font-mono);
    font-size: 12.5px;
    font-weight: 700;
    color: #fff;
  }
  .btn-send-whistleblower {
    background: var(--gold-lupa);
    color: #fff;
    font-size: 12px;
    font-weight: 700;
    padding: 10px;
    border-radius: 4px;
    display: flex;
    justify-content: center;
    align-items: center;
    transition: background 0.15s;
  }
  .btn-send-whistleblower:hover {
    background: var(--gold-dark);
  }

  @media (max-width: 900px) {
    .lead-dossier {
      grid-template-columns: 1fr;
    }
    .investigations-grid {
      grid-template-columns: 1fr;
    }
    .radar-whistleblower-section {
      grid-template-columns: 1fr;
    }
  }
</style>
