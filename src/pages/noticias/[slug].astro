---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const articles = await getCollection('noticias');
  return articles.map(article => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);

const formatDate = (d: Date) => {
  return new Intl.DateTimeFormat('es-MX', {
    weekday: 'long',
    day: 'numeric',
    month: 'long',
    year: 'numeric'
  }).format(d);
};
---

<BaseLayout
  title={article.data.title}
  description={article.data.excerpt || article.data.subtitle}
  image={article.data.image}
  type="article"
  pubDate={article.data.pubDate}
  author={article.data.author}
>
  <article class="article-page">
    <div class="container article-container">

      <!-- BREADCRUMB -->
      <nav class="breadcrumb" aria-label="Migas de pan">
        <a href="/">Inicio</a>
        <span>/</span>
        <a href={`/seccion/${article.data.category.toLowerCase().replace(/\s+/g, '-').normalize("NFD").replace(/[\u0300-\u036f]/g, "")}/`}>{article.data.category}</a>
        <span>/</span>
        <span class="breadcrumb-current">Expediente</span>
      </nav>

      <!-- ENCABEZADO EDITORIAL -->
      <header class="article-header">
        <div class="article-meta-badges">
          {article.data.expedienteNo && (
            <span class="expediente-badge">{article.data.expedienteNo}</span>
          )}
          <span class="category-badge">{article.data.category}</span>
          {article.data.status && (
            <span class="status-badge">{article.data.status}</span>
          )}
        </div>

        <h1 class="article-title">{article.data.title}</h1>

        {article.data.subtitle && (
          <p class="article-subtitle">{article.data.subtitle}</p>
        )}

        <div class="article-byline">
          <div class="author-block">
            <span class="author-label">Investigación:</span>
            <span class="author-name">{article.data.author}</span>
          </div>
          <div class="date-block">
            <time datetime={article.data.pubDate.toISOString()}>{formatDate(article.data.pubDate)}</time>
          </div>
        </div>
      </header>

      <!-- FOTO PRINCIPAL -->
      {article.data.image && (
        <figure class="article-hero-media">
          <img src={article.data.image} alt={article.data.title} class="article-hero-img" />
          {article.data.imageCaption && (
            <figcaption class="article-hero-caption">{article.data.imageCaption}</figcaption>
          )}
        </figure>
      )}

      <!-- CUERPO DE LA NOTA -->
      <div class="article-body">
        <Content />
      </div>

      <!-- ETIQUETAS -->
      {article.data.tags && article.data.tags.length > 0 && (
        <div class="article-tags-wrap">
          <span class="tags-label">Descriptores:</span>
          <div class="tags-list">
            {article.data.tags.map(t => (
              <span class="tag-pill">#{t}</span>
            ))}
          </div>
        </div>
      )}

      <!-- COMPARTIR & RETORNO -->
      <div class="article-actions-bar">
        <a href="/" class="btn-back">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
          <span>Volver a Portada</span>
        </a>
        <a
          href={`https://wa.me/?text=${encodeURIComponent(`${article.data.title} - Lee la investigación en Bajo la Lupa CDMX: ${Astro.url.href}`)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-share-wa"
        >
          <span>Compartir en WhatsApp</span>
        </a>
      </div>

      <!-- LLAMADO A DENUNCIA -->
      <section class="dossier-whistleblower-callout">
        <div class="callout-inner">
          <h3>¿Cuentas con información adicional sobre este caso?</h3>
          <p>
            En <strong>Bajo la Lupa CDMX</strong> protegemos el secreto profesional y el anonimato de nuestras fuentes ciudadanas. Escríbenos directamente para aportar contratos, audios, fotos o testimonios verificables.
          </p>
          <a href="mailto:denuncia@bajolalupa.com.mx" class="callout-btn">Aportar datos a: denuncia@bajolalupa.com.mx</a>
        </div>
      </section>

    </div>
  </article>
</BaseLayout>

<style>
  .article-container {
    max-width: 820px;
    padding-top: 25px;
    padding-bottom: 60px;
  }

  .breadcrumb {
    font-size: 12px;
    color: var(--ink-muted);
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .breadcrumb a:hover {
    color: var(--gold-lupa);
  }
  .breadcrumb-current {
    color: var(--ink-primary);
    font-weight: 600;
  }

  .article-header {
    margin-bottom: 28px;
  }
  .article-meta-badges {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 14px;
    flex-wrap: wrap;
  }
  .expediente-badge {
    background: var(--gold-subtle);
    border: 1px solid var(--gold-border);
    color: var(--gold-dark);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 3px;
  }
  .category-badge {
    background: var(--ink-primary);
    color: #fff;
    font-size: 11px;
    font-weight: 800;
    padding: 3px 8px;
    border-radius: 3px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .status-badge {
    background: #e0f2fe;
    color: #0369a1;
    font-size: 11px;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 3px;
  }

  .article-title {
    font-family: var(--font-headline); letter-spacing: -0.02em;
    font-size: 30px; font-weight: 800;
    line-height: 1.25;
    color: var(--ink-primary);
    margin-bottom: 16px;
    font-weight: 700;
  }
  .article-subtitle {
    font-size: 16.5px;
    color: var(--ink-secondary);
    line-height: 1.5;
    margin-bottom: 22px;
    font-weight: 500;
  }

  .article-byline {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid var(--border-light);
    border-bottom: 1px solid var(--border-light);
    padding: 12px 0;
    font-size: 12.5px;
    color: var(--ink-muted);
  }
  .author-block {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .author-label {
    text-transform: uppercase;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.05em;
  }
  .author-name {
    font-weight: 700;
    color: var(--ink-primary);
  }

  .article-hero-media {
    margin: 28px 0 35px;
  }
  .article-hero-img {
    width: 100%;
    max-height: 480px;
    object-fit: cover;
    border-radius: 4px;
  }
  .article-hero-caption {
    font-size: 12px;
    color: var(--ink-muted);
    font-style: italic;
    margin-top: 8px;
    border-left: 2px solid var(--gold-lupa);
    padding-left: 10px;
  }

  /* ARTICLE BODY TYPOGRAPHY */
  .article-body {
    font-size: 16.5px;
    line-height: 1.8;
    color: #24292f;
  }
  .article-body :global(p) {
    margin-bottom: 22px;
  }
  .article-body :global(h2), .article-body :global(h3) {
    font-family: var(--font-headline); letter-spacing: -0.02em;
    color: var(--ink-primary);
    margin: 36px 0 16px;
    font-weight: 700;
    line-height: 1.3;
  }
  .article-body :global(h2) {
    font-size: 23px;
    border-bottom: 1px solid var(--border-light);
    padding-bottom: 8px;
  }
  .article-body :global(h3) {
    font-size: 19px;
  }
  .article-body :global(blockquote) {
    border-left: 3px solid var(--gold-lupa);
    background: var(--gold-subtle);
    padding: 16px 20px;
    margin: 28px 0;
    font-style: italic;
    color: var(--ink-secondary);
    border-radius: 0 4px 4px 0;
  }
  .article-body :global(ul), .article-body :global(ol) {
    margin: 20px 0 24px 25px;
  }
  .article-body :global(li) {
    margin-bottom: 8px;
  }
  .article-body :global(strong) {
    color: var(--ink-primary);
    font-weight: 700;
  }

  /* TAGS */
  .article-tags-wrap {
    margin-top: 40px;
    padding-top: 20px;
    border-top: 1px solid var(--border-light);
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }
  .tags-label {
    font-size: 12px;
    font-weight: 700;
    color: var(--ink-muted);
    text-transform: uppercase;
  }
  .tags-list {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .tag-pill {
    background: #edf2f7;
    color: var(--ink-secondary);
    font-size: 11.5px;
    font-weight: 600;
    padding: 3px 9px;
    border-radius: 4px;
  }

  /* ACTIONS BAR */
  .article-actions-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 30px;
    padding: 16px 0;
    border-top: 1px solid var(--border-light);
    border-bottom: 1px solid var(--border-light);
  }
  .btn-back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 700;
    color: var(--ink-secondary);
  }
  .btn-back:hover {
    color: var(--gold-lupa);
  }
  .btn-share-wa {
    background: #25d366;
    color: #fff;
    font-size: 12.5px;
    font-weight: 700;
    padding: 8px 14px;
    border-radius: 4px;
  }

  /* WHISTLEBLOWER CALLOUT */
  .dossier-whistleblower-callout {
    margin-top: 45px;
    background: #181b1e;
    color: #fff;
    border-radius: 6px;
    padding: 28px;
    border-left: 4px solid var(--gold-lupa);
  }
  .callout-inner h3 {
    font-family: var(--font-headline); letter-spacing: -0.02em;
    font-size: 18px;
    margin-bottom: 10px;
  }
  .callout-inner p {
    font-size: 13px;
    color: #cbd5e1;
    line-height: 1.6;
    margin-bottom: 18px;
  }
  .callout-btn {
    display: inline-block;
    background: var(--gold-lupa);
    color: #fff;
    font-size: 12.5px;
    font-weight: 700;
    padding: 9px 16px;
    border-radius: 4px;
  }

  @media (max-width: 768px) {
    .article-title {
      font-size: 25px;
    }
  }
</style>
